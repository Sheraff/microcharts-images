{
  "name": "microcharts-images",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "generate:check": "pnpm generate && git diff --exit-code -- src/catalog.generated.ts src/registry.generated.ts src/styles.generated.css",
    "build": "pnpm generate && wrangler deploy --dry-run --outdir dist",
    "check": "pnpm generate:check && tsc --noEmit && vitest run && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm check && wrangler deploy",
    "dev": "wrangler dev",
    "test": "pnpm generate && vitest run",
    "test:watch": "vitest",
    "types": "wrangler types --env-interface Env worker-configuration.d.ts",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "0.3.0",
    "@microcharts/react": "0.10.0",
    "hono": "4.12.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@xmldom/xmldom": "0.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18"
  }
}
